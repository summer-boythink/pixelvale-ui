{
  "name": "pixelvale-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pixelvale/playground",
    "build": "npm run build --workspace @pixelvale/ui && npm run build --workspace @pixelvale/playground",
    "build:lib": "npm run build --workspace @pixelvale/ui",
    "preview": "npm run preview --workspace @pixelvale/playground",
    "test": "npm run test --workspace @pixelvale/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css}\" \"apps/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css}\" \"apps/**/*.{ts,tsx,css}\" \"*.{json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
