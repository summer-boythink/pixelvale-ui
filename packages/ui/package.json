{
  "name": "@pixelvale/ui",
  "version": "0.1.0",
  "description": "A cozy, Stardew-inspired pixel UI component library for React + TypeScript.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "pixel",
    "retro",
    "farm",
    "stardew-inspired",
    "typescript",
    "design-system",
    "accessibility",
    "i18n",
    "locale",
    "chinese",
    "calendar",
    "data-table",
    "tree-view",
    "popover"
  ]
}
